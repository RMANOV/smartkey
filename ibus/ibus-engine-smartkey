#!/bin/bash
# SmartKey IBus engine launcher
cd /home/rmanov/smartkey
export PYTHONPATH="/home/rmanov/smartkey/ibus:$PYTHONPATH"

# Keep the undeclared-field policy opt-in. Strict mode cannot prove that every
# IBus client will deliver an unhandled first key, so enabling it globally can
# make the first key in a field appear lost. Declared PASSWORD/PIN and
# PRIVATE/HIDDEN_TEXT fields still fail closed inside the engine.
export SMARTKEY_SENSITIVE_UNTIL_DECLARED=0

# Production mode: content logging stays off unless diagnostics are explicitly
# enabled with `smartkey-debug` before the engine starts.

exec /home/rmanov/smartkey/.venv/bin/python3 -m ibus.main "$@"
